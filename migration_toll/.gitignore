# Environment files
.env
.env.local          # real local secrets — never commit
.env.*.local        # real local secrets — never commit

# env.example and env.development/staging/production use ${VAR} placeholders
# and ARE committed — they're templates, not secrets

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
!.env.example

