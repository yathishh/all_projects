#!/bin/bash
# ============================================================
# run-migration — Wrapper script for Liquibase
# Generated by Ansible
# Usage:
#   run-migration update
#   run-migration status
#   run-migration rollbackCount 1
#   run-migration validate
# ============================================================

set -euo pipefail

PROJECT_DIR="{{ liquibase_project_dir }}"
LOG_FILE="/var/log/liquibase/migration-$(date +%Y%m%d-%H%M%S).log"

mkdir -p /var/log/liquibase

echo "========================================" | tee -a "$LOG_FILE"
echo " Liquibase Migration - $(date)"          | tee -a "$LOG_FILE"
echo " Command: $*"                             | tee -a "$LOG_FILE"
echo "========================================" | tee -a "$LOG_FILE"

cd "$PROJECT_DIR"

liquibase \
  --defaultsFile="${PROJECT_DIR}/liquibase.properties" \
  "$@" 2>&1 | tee -a "$LOG_FILE"

EXIT_CODE=${PIPESTATUS[0]}

if [ $EXIT_CODE -eq 0 ]; then
  echo ""
  echo "✅ Migration completed successfully." | tee -a "$LOG_FILE"
else
  echo ""
  echo "❌ Migration FAILED. Check log: $LOG_FILE" | tee -a "$LOG_FILE"
  exit $EXIT_CODE
fi
