name: Database Migration

on:
  pull_request:
    branches: [main]
    paths:
      - 'changelog/**'
  push:
    branches: [main]
    paths:
      - 'changelog/**'

jobs:
  # ── Job 1: Validate on PR ──────────────────────────────────
  validate:
    name: Validate Changelog
    runs-on: [self-hosted, ubuntu, liquibase]  # Uses your self-hosted runner
    if: github.event_name == 'pull_request'

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Copy changelog to migration server
        run: |
          rsync -avz --delete changelog/ \
            {{ app_user }}@{{ hostvars['migration-server']['ansible_host'] }}:{{ liquibase_project_dir }}/changelog/

      - name: Run Liquibase validate
        run: |
          ssh {{ app_user }}@{{ hostvars['migration-server']['ansible_host'] }} \
            "run-migration validate"

      - name: Run Liquibase status (dry run)
        run: |
          ssh {{ app_user }}@{{ hostvars['migration-server']['ansible_host'] }} \
            "run-migration status"

  # ── Job 2: Deploy on Merge to Main ─────────────────────────
  deploy:
    name: Deploy Migration
    runs-on: [self-hosted, ubuntu, liquibase]
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Copy changelog to migration server
        run: |
          rsync -avz --delete changelog/ \
            {{ app_user }}@{{ hostvars['migration-server']['ansible_host'] }}:{{ liquibase_project_dir }}/changelog/

      - name: Tag DB state before migration
        run: |
          ssh {{ app_user }}@{{ hostvars['migration-server']['ansible_host'] }} \
            "run-migration tag --tag=pre-${{ '{{' }} github.run_number }}"

      - name: Apply migrations
        run: |
          ssh {{ app_user }}@{{ hostvars['migration-server']['ansible_host'] }} \
            "run-migration update"

      - name: Verify migration status
        run: |
          ssh {{ app_user }}@{{ hostvars['migration-server']['ansible_host'] }} \
            "run-migration status"

      # Uncomment to enable auto-rollback on failure:
