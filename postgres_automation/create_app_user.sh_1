#!/bin/bash
# =============================================================
# Script: create_app_user.sh
# Purpose: Create an app user and grant access to specific DB
# Usage:   ./create_app_user.sh <username> <password> <database>
# Example: ./create_app_user.sh app_sales 'Secret@123' sales_db
#
# PG16 Fix: Uses "WITH INHERIT TRUE" for role grant
# =============================================================

DB_HOST="172.30.19.51"
DB_PORT="5432"
DB_SUPERUSER="postgres"
ROLE_NAME="global_rw"

# ---------- Input validation ----------
if [ "$#" -ne 3 ]; then
  echo "Usage: $0 <username> <password> <database>"
  echo "Example: $0 app_sales 'Secret@123' sales_db"
  exit 1
fi

APP_USER="$1"
APP_PASS="$2"
TARGET_DB="$3"

echo "======================================================"
echo " Creating user : $APP_USER"
echo " Target DB     : $TARGET_DB"
echo "======================================================"

# Step 1: Verify the target database exists
DB_EXISTS=$(psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -Atc \
  "SELECT 1 FROM pg_database WHERE datname = '$TARGET_DB';")

if [ "$DB_EXISTS" != "1" ]; then
  echo "ERROR: Database '$TARGET_DB' does not exist!"
  echo "Tip: First create it using ./add_new_database.sh $TARGET_DB"
  exit 1
fi

# Step 2: Check if user already exists
USER_EXISTS=$(psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -Atc \
  "SELECT 1 FROM pg_roles WHERE rolname = '$APP_USER';")

if [ "$USER_EXISTS" = "1" ]; then
  echo "WARNING: User '$APP_USER' already exists. Skipping creation."
  echo "Tip: To add more DBs to this user, use ./grant_user_databases.sh"
else
  # Step 3: Create the user with INHERIT=true (PG16 compatible)
  psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d postgres -c "
    CREATE USER \"$APP_USER\" WITH
      LOGIN
      NOSUPERUSER
      NOCREATEDB
      NOCREATEROLE
      INHERIT
      NOREPLICATION
      NOBYPASSRLS
      CONNECTION LIMIT 50
      PASSWORD '$APP_PASS';
  "
  echo "✔ User '$APP_USER' created."
fi

# Step 4: Assign global_rw role WITH INHERIT TRUE (PG16 fix)
# This ensures the user actually inherits role permissions in PG16+
psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d postgres \
  -c "GRANT $ROLE_NAME TO \"$APP_USER\" WITH INHERIT TRUE;"
echo "✔ Role '$ROLE_NAME' granted to '$APP_USER' (WITH INHERIT TRUE)."

# Step 5: Grant CONNECT only on the specific target DB
psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d postgres \
  -c "GRANT CONNECT ON DATABASE \"$TARGET_DB\" TO \"$APP_USER\";"
echo "✔ CONNECT granted on '$TARGET_DB'."

# Step 6: Revoke PUBLIC connect on target DB (security best practice)
psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d postgres \
  -c "REVOKE CONNECT ON DATABASE \"$TARGET_DB\" FROM PUBLIC;"
echo "✔ PUBLIC connect revoked on '$TARGET_DB'."

# Step 7: Verify schema access
SCHEMA_CHECK=$(psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d "$TARGET_DB" -Atc "
  SELECT string_agg(schema_name, ', ') FROM information_schema.schemata
  WHERE schema_name NOT IN ('pg_catalog', 'information_schema', 'pg_toast')
  AND schema_name NOT LIKE 'pg_%'
  AND has_schema_privilege('$APP_USER', schema_name, 'USAGE');
")

# Step 8: Print summary
echo ""
echo "======================================================"
echo " ✔ User '$APP_USER' setup COMPLETE!"
echo "   -> Can connect to : $TARGET_DB ONLY"
echo "   -> Has role       : $ROLE_NAME (WITH INHERIT TRUE)"
echo "   -> Schema access  : ${SCHEMA_CHECK:-none yet — add schemas using add_new_schema.sh}"
echo "======================================================"

echo ""
echo "--- Verify with: ---"
echo "SELECT has_schema_privilege('$APP_USER', '<schema_name>', 'USAGE');"
echo "SELECT datname FROM pg_database WHERE has_database_privilege('$APP_USER', datname, 'CONNECT') AND datistemplate = false;"
