#!/bin/bash
# =============================================================
# Script: add_new_database.sh
# Purpose: Create new DB + auto-grant global_rw role on it
# Usage:   ./add_new_database.sh <new_database_name>
# Example: ./add_new_database.sh analytics_db
# =============================================================

DB_HOST="172.30.19.51"
DB_PORT="5432"
DB_SUPERUSER="postgres"
ROLE_NAME="global_rw"

# ---------- Input validation ----------
if [ "$#" -ne 1 ]; then
  echo "Usage: $0 <new_database_name>"
  echo "Example: $0 analytics_db"
  exit 1
fi

NEW_DB="$1"

echo "======================================================"
echo " Setting up new database: $NEW_DB"
echo "======================================================"

# Step 1: Check if DB already exists
DB_EXISTS=$(psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -Atc \
  "SELECT 1 FROM pg_database WHERE datname = '$NEW_DB';")

if [ "$DB_EXISTS" = "1" ]; then
  echo "ERROR: Database '$NEW_DB' already exists!"
  exit 1
fi

# Step 2: Create the new database
psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d postgres \
  -c "CREATE DATABASE \"$NEW_DB\";"
echo "✔ Database '$NEW_DB' created."

# Step 3: Revoke PUBLIC connect (security best practice)
psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d postgres \
  -c "REVOKE CONNECT ON DATABASE \"$NEW_DB\" FROM PUBLIC;"
echo "✔ PUBLIC connect revoked."

# NOTE: CONNECT is NOT granted to global_rw role
# It will be granted per user using create_app_user.sh
echo "  (CONNECT will be granted per user — not to role)"

# Step 4: Get all schemas in new DB and grant permissions
SCHEMAS=$(psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d "$NEW_DB" -Atc "
  SELECT schema_name FROM information_schema.schemata
  WHERE schema_name NOT IN ('pg_catalog', 'information_schema', 'pg_toast')
  AND schema_name NOT LIKE 'pg_%'
  ORDER BY schema_name;
")

# Default to public schema if none found
if [ -z "$SCHEMAS" ]; then
  echo "  No schemas yet — applying grants to public schema..."
  SCHEMAS="public"
fi

for SCHEMA in $SCHEMAS; do
  echo "  -> Granting on schema: $SCHEMA"

  psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d "$NEW_DB" \
    -c "GRANT USAGE ON SCHEMA \"$SCHEMA\" TO $ROLE_NAME;"

  psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d "$NEW_DB" \
    -c "GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA \"$SCHEMA\" TO $ROLE_NAME;"

  psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d "$NEW_DB" \
    -c "GRANT USAGE, SELECT, UPDATE ON ALL SEQUENCES IN SCHEMA \"$SCHEMA\" TO $ROLE_NAME;"

  psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d "$NEW_DB" \
    -c "GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA \"$SCHEMA\" TO $ROLE_NAME;"

  psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d "$NEW_DB" \
    -c "ALTER DEFAULT PRIVILEGES IN SCHEMA \"$SCHEMA\" GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO $ROLE_NAME;"

  psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d "$NEW_DB" \
    -c "ALTER DEFAULT PRIVILEGES IN SCHEMA \"$SCHEMA\" GRANT USAGE, SELECT, UPDATE ON SEQUENCES TO $ROLE_NAME;"

  psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d "$NEW_DB" \
    -c "ALTER DEFAULT PRIVILEGES IN SCHEMA \"$SCHEMA\" GRANT EXECUTE ON FUNCTIONS TO $ROLE_NAME;"

  # Verify
  RESULT=$(psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_SUPERUSER" -d "$NEW_DB" -Atc \
    "SELECT has_schema_privilege('$ROLE_NAME', '$SCHEMA', 'USAGE');")

  if [ "$RESULT" = "t" ]; then
    echo "  ✔ Done: $NEW_DB -> $SCHEMA"
  else
    echo "  ❌ FAILED: $NEW_DB -> $SCHEMA (verify manually!)"
  fi
done

echo ""
echo "======================================================"
echo " ✔ New database '$NEW_DB' setup COMPLETE!"
echo "   -> global_rw has full RW on all schemas"
echo "   -> PUBLIC connect is blocked"
echo "   -> To add a user: ./create_app_user.sh <user> <pass> $NEW_DB"
echo "======================================================"
